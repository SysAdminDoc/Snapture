<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>Snapture.App.Program</StartupObject>
    <UseWindowsForms>false</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>
    <RootNamespace>Snapture.App</RootNamespace>
    <Product>Snapture</Product>
    <Company>SysAdminDoc</Company>
    <Copyright>Copyright (c) 2026 Matt Parker</Copyright>
    <AssemblyTitle>Snapture</AssemblyTitle>
    <Description>All-in-one screenshot utility for Windows.</Description>
    <RollForward>LatestPatch</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="1.8.76" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="1.8.260505001" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260508005" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.27.1" />
    <PackageReference Include="RapidOcrNet" Version="3.0.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.Svg" Version="1.60.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'win-arm64'">
    <PackageReference Include="Magick.NET-Q8-arm64" Version="14.15.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'win-arm64'">
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.15.0" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Snapture.Capture\Snapture.Capture.csproj" />
    <ProjectReference Include="..\Snapture.Plugin.Abstractions\Snapture.Plugin.Abstractions.csproj" />
  </ItemGroup>
</Project>
