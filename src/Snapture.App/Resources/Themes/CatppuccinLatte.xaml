<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Catppuccin Latte palette. Keys match Mocha so windows can switch dictionaries at runtime. -->
    <Color x:Key="BaseColor">#FFEFF1F5</Color>
    <Color x:Key="MantleColor">#FFE6E9EF</Color>
    <Color x:Key="CrustColor">#FFDCE0E8</Color>
    <Color x:Key="Surface0Color">#FFCCD0DA</Color>
    <Color x:Key="Surface1Color">#FFBCC0CC</Color>
    <Color x:Key="Surface2Color">#FFACB0BE</Color>
    <Color x:Key="Overlay0Color">#FF9CA0B0</Color>
    <Color x:Key="Overlay1Color">#FF8C8FA1</Color>
    <Color x:Key="Overlay2Color">#FF7C7F93</Color>
    <Color x:Key="SubtextColor">#FF6C6F85</Color>
    <Color x:Key="TextColor">#FF4C4F69</Color>
    <Color x:Key="LavenderColor">#FF7287FD</Color>
    <Color x:Key="BlueColor">#FF1E66F5</Color>
    <Color x:Key="SapphireColor">#FF209FB5</Color>
    <Color x:Key="SkyColor">#FF04A5E5</Color>
    <Color x:Key="TealColor">#FF179299</Color>
    <Color x:Key="GreenColor">#FF40A02B</Color>
    <Color x:Key="YellowColor">#FFDF8E1D</Color>
    <Color x:Key="PeachColor">#FFFE640B</Color>
    <Color x:Key="MaroonColor">#FFE64553</Color>
    <Color x:Key="RedColor">#FFD20F39</Color>
    <Color x:Key="MauveColor">#FF8839EF</Color>
    <Color x:Key="PinkColor">#FFEA76CB</Color>
    <Color x:Key="FlamingoColor">#FFDD7878</Color>
    <Color x:Key="RosewaterColor">#FFDC8A78</Color>

    <Color x:Key="AppBackgroundColor">#FFEFF1F5</Color>
    <Color x:Key="AppForegroundColor">#FF4C4F69</Color>
    <Color x:Key="AppSurfaceColor">#FFE6E9EF</Color>
    <Color x:Key="AppSurfaceRaisedColor">#FFFFFFFF</Color>
    <Color x:Key="AppSurfaceHoverColor">#FFE0E4EC</Color>
    <Color x:Key="AppSurfacePressedColor">#FFD3D8E3</Color>
    <Color x:Key="AppCanvasColor">#FFDCE0E8</Color>
    <Color x:Key="AppBorderColor">#FFCCD0DA</Color>
    <Color x:Key="AppBorderStrongColor">#FFACB0BE</Color>
    <Color x:Key="AppMutedForegroundColor">#FF6C6F85</Color>
    <Color x:Key="AppSubtleForegroundColor">#FF7C7F93</Color>
    <Color x:Key="AppDisabledForegroundColor">#FF8C8FA1</Color>
    <Color x:Key="AppAccentColor">#FF8839EF</Color>
    <Color x:Key="AppAccentHoverColor">#FF6D21D8</Color>
    <Color x:Key="AppAccentPressedColor">#FF5D19BD</Color>
    <Color x:Key="AppAccentForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="AppInputBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="AppInputForegroundColor">#FF4C4F69</Color>
    <Color x:Key="AppSelectionColor">#338839EF</Color>
    <Color x:Key="AppSelectionForegroundColor">#FF11111B</Color>
    <Color x:Key="AppFocusColor">#FF1E66F5</Color>
    <Color x:Key="AppOverlayColor">#99000000</Color>
    <Color x:Key="AppShadowColor">#FF3B3F56</Color>
    <Color x:Key="AppDestructiveColor">#FFD20F39</Color>
    <Color x:Key="AppDestructiveForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="AppSuccessColor">#FF40A02B</Color>
    <Color x:Key="AppWarningColor">#FFB86E00</Color>
    <Color x:Key="AppInfoColor">#FF1E66F5</Color>

    <SolidColorBrush x:Key="Base" Color="{StaticResource BaseColor}" />
    <SolidColorBrush x:Key="Mantle" Color="{StaticResource MantleColor}" />
    <SolidColorBrush x:Key="Crust" Color="{StaticResource CrustColor}" />
    <SolidColorBrush x:Key="Surface0" Color="{StaticResource Surface0Color}" />
    <SolidColorBrush x:Key="Surface1" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Overlay0" Color="{StaticResource Overlay0Color}" />
    <SolidColorBrush x:Key="Overlay1" Color="{StaticResource Overlay1Color}" />
    <SolidColorBrush x:Key="Overlay2" Color="{StaticResource Overlay2Color}" />
    <SolidColorBrush x:Key="Subtext" Color="{StaticResource SubtextColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Lavender" Color="{StaticResource LavenderColor}" />
    <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="Sapphire" Color="{StaticResource SapphireColor}" />
    <SolidColorBrush x:Key="Sky" Color="{StaticResource SkyColor}" />
    <SolidColorBrush x:Key="Teal" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}" />
    <SolidColorBrush x:Key="Peach" Color="{StaticResource PeachColor}" />
    <SolidColorBrush x:Key="Maroon" Color="{StaticResource MaroonColor}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="Mauve" Color="{StaticResource MauveColor}" />
    <SolidColorBrush x:Key="Pink" Color="{StaticResource PinkColor}" />

    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="AppForeground" Color="{StaticResource AppForegroundColor}" />
    <SolidColorBrush x:Key="AppSurface" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="AppSurfaceRaised" Color="{StaticResource AppSurfaceRaisedColor}" />
    <SolidColorBrush x:Key="AppSurfaceHover" Color="{StaticResource AppSurfaceHoverColor}" />
    <SolidColorBrush x:Key="AppSurfacePressed" Color="{StaticResource AppSurfacePressedColor}" />
    <SolidColorBrush x:Key="AppCanvas" Color="{StaticResource AppCanvasColor}" />
    <SolidColorBrush x:Key="AppBorder" Color="{StaticResource AppBorderColor}" />
    <SolidColorBrush x:Key="AppBorderStrong" Color="{StaticResource AppBorderStrongColor}" />
    <SolidColorBrush x:Key="AppMutedForeground" Color="{StaticResource AppMutedForegroundColor}" />
    <SolidColorBrush x:Key="AppSubtleForeground" Color="{StaticResource AppSubtleForegroundColor}" />
    <SolidColorBrush x:Key="AppDisabledForeground" Color="{StaticResource AppDisabledForegroundColor}" />
    <SolidColorBrush x:Key="AppAccent" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccentHover" Color="{StaticResource AppAccentHoverColor}" />
    <SolidColorBrush x:Key="AppAccentPressed" Color="{StaticResource AppAccentPressedColor}" />
    <SolidColorBrush x:Key="AppAccentForeground" Color="{StaticResource AppAccentForegroundColor}" />
    <SolidColorBrush x:Key="AppInputBackground" Color="{StaticResource AppInputBackgroundColor}" />
    <SolidColorBrush x:Key="AppInputForeground" Color="{StaticResource AppInputForegroundColor}" />
    <SolidColorBrush x:Key="AppSelection" Color="{StaticResource AppSelectionColor}" />
    <SolidColorBrush x:Key="AppSelectionForeground" Color="{StaticResource AppSelectionForegroundColor}" />
    <SolidColorBrush x:Key="AppFocus" Color="{StaticResource AppFocusColor}" />
    <SolidColorBrush x:Key="AppOverlay" Color="{StaticResource AppOverlayColor}" />
    <SolidColorBrush x:Key="AppShadow" Color="{StaticResource AppShadowColor}" />
    <SolidColorBrush x:Key="AppDestructive" Color="{StaticResource AppDestructiveColor}" />
    <SolidColorBrush x:Key="AppDestructiveForeground" Color="{StaticResource AppDestructiveForegroundColor}" />
    <SolidColorBrush x:Key="AppSuccess" Color="{StaticResource AppSuccessColor}" />
    <SolidColorBrush x:Key="AppWarning" Color="{StaticResource AppWarningColor}" />
    <SolidColorBrush x:Key="AppInfo" Color="{StaticResource AppInfoColor}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AccentSecondary" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="SelectionStroke" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="SelectionFill" Color="#338839EF" />
    <SolidColorBrush x:Key="DimBackdrop" Color="{StaticResource AppOverlayColor}" />
</ResourceDictionary>
