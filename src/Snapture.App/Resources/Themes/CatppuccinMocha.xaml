<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--  Catppuccin Mocha palette  -->
    <Color x:Key="BaseColor">#FF1E1E2E</Color>
    <Color x:Key="MantleColor">#FF181825</Color>
    <Color x:Key="CrustColor">#FF11111B</Color>
    <Color x:Key="Surface0Color">#FF313244</Color>
    <Color x:Key="Surface1Color">#FF45475A</Color>
    <Color x:Key="Surface2Color">#FF585B70</Color>
    <Color x:Key="Overlay0Color">#FF6C7086</Color>
    <Color x:Key="Overlay1Color">#FF7F849C</Color>
    <Color x:Key="Overlay2Color">#FF9399B2</Color>
    <Color x:Key="SubtextColor">#FFA6ADC8</Color>
    <Color x:Key="TextColor">#FFCDD6F4</Color>
    <Color x:Key="LavenderColor">#FFB4BEFE</Color>
    <Color x:Key="BlueColor">#FF89B4FA</Color>
    <Color x:Key="SapphireColor">#FF74C7EC</Color>
    <Color x:Key="SkyColor">#FF89DCEB</Color>
    <Color x:Key="TealColor">#FF94E2D5</Color>
    <Color x:Key="GreenColor">#FFA6E3A1</Color>
    <Color x:Key="YellowColor">#FFF9E2AF</Color>
    <Color x:Key="PeachColor">#FFFAB387</Color>
    <Color x:Key="MaroonColor">#FFEBA0AC</Color>
    <Color x:Key="RedColor">#FFF38BA8</Color>
    <Color x:Key="MauveColor">#FFCBA6F7</Color>
    <Color x:Key="PinkColor">#FFF5C2E7</Color>
    <Color x:Key="FlamingoColor">#FFF2CDCD</Color>
    <Color x:Key="RosewaterColor">#FFF5E0DC</Color>

    <SolidColorBrush x:Key="Base" Color="{StaticResource BaseColor}" />
    <SolidColorBrush x:Key="Mantle" Color="{StaticResource MantleColor}" />
    <SolidColorBrush x:Key="Crust" Color="{StaticResource CrustColor}" />
    <SolidColorBrush x:Key="Surface0" Color="{StaticResource Surface0Color}" />
    <SolidColorBrush x:Key="Surface1" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Overlay0" Color="{StaticResource Overlay0Color}" />
    <SolidColorBrush x:Key="Overlay1" Color="{StaticResource Overlay1Color}" />
    <SolidColorBrush x:Key="Subtext" Color="{StaticResource SubtextColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Lavender" Color="{StaticResource LavenderColor}" />
    <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="Sapphire" Color="{StaticResource SapphireColor}" />
    <SolidColorBrush x:Key="Sky" Color="{StaticResource SkyColor}" />
    <SolidColorBrush x:Key="Teal" Color="{StaticResource TealColor}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}" />
    <SolidColorBrush x:Key="Peach" Color="{StaticResource PeachColor}" />
    <SolidColorBrush x:Key="Maroon" Color="{StaticResource MaroonColor}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="Mauve" Color="{StaticResource MauveColor}" />
    <SolidColorBrush x:Key="Pink" Color="{StaticResource PinkColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource MauveColor}" />
    <SolidColorBrush x:Key="AccentSecondary" Color="{StaticResource BlueColor}" />

    <!--  Selection ring used during region capture  -->
    <SolidColorBrush x:Key="SelectionStroke" Color="{StaticResource MauveColor}" />
    <SolidColorBrush x:Key="SelectionFill" Color="#33CBA6F7" />
    <SolidColorBrush x:Key="DimBackdrop" Color="#B3000000" />

    <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI</FontFamily>
    <sys:Double x:Key="UiFontSize">13</sys:Double>

    <Style TargetType="{x:Type Window}" x:Key="DarkWindow">
        <Setter Property="Background" Value="{StaticResource Base}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style TargetType="{x:Type Button}" x:Key="ToolbarButton">
        <Setter Property="Background" Value="{StaticResource Surface0}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface1}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface1}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Mauve}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource Surface2}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Overlay0}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Surface0}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButton}" />

    <Style TargetType="{x:Type Button}" x:Key="AccentButton" BasedOn="{StaticResource ToolbarButton}">
        <Setter Property="Background" Value="{StaticResource Mauve}" />
        <Setter Property="Foreground" Value="{StaticResource Crust}" />
        <Setter Property="BorderBrush" Value="{StaticResource Mauve}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    </Style>

    <Style TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{StaticResource Mantle}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Background" Value="{StaticResource Mantle}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource Surface1}" />
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{StaticResource Surface1}" />
        <Setter Property="Margin" Value="4,4" />
        <Setter Property="Height" Value="1" />
    </Style>

</ResourceDictionary>
