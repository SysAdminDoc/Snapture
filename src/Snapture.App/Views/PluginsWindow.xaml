<Window x:Class="Snapture.App.Views.PluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture — Plugins"
        Width="780" Height="540"
        MinWidth="540" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Base}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource Mantle}"
                BorderBrush="{StaticResource Surface0}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="True">
                <TextBlock Text="✦ Plugins"
                           Foreground="{StaticResource Mauve}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button Content="Open plugins folder" Click="OnOpenFolderClicked" />
                    <Button x:Name="ReloadButton"
                            Content="Reload all"
                            Style="{StaticResource AccentButton}"
                            Click="OnReloadClicked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PluginList" Margin="14" />
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{StaticResource Mantle}"
                BorderBrush="{StaticResource Surface0}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource Subtext}"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
