<Window x:Class="Snapture.App.Views.PluginsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture — Plugins"
        Width="780" Height="540"
        MinWidth="540" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource HeaderBar}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Plugins"
                           Style="{StaticResource WindowTitleText}"
                           Foreground="{DynamicResource AppAccent}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                    <TextBlock Text="Inspect installed extensions and reload them without restarting Snapture."
                               Style="{StaticResource HelpText}"
                               Margin="0,4,16,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button Content="Open folder" Click="OnOpenFolderClicked" />
                    <Button x:Name="ReloadButton"
                            Content="Reload all"
                            Style="{StaticResource AccentButton}"
                            Click="OnReloadClicked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PluginList" Margin="14" />
        </ScrollViewer>

        <Border Grid.Row="2"
                Style="{StaticResource FooterBar}"
                Padding="14,8">
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource AppMutedForeground}"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
