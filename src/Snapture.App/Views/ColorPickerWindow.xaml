<Window x:Class="Snapture.App.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture - Color Picker"
        Width="460" Height="428"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Border Margin="14"
            Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppBorderStrong}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Color Picker"
                       Style="{StaticResource SectionTitleText}"
                       Foreground="{DynamicResource AppForeground}" />
            <TextBlock Text="Hover anywhere on screen; the swatch updates live."
                       Style="{StaticResource HelpText}" />
        </StackPanel>

        <Border Grid.Row="1"
                x:Name="SwatchBorder"
                Background="{DynamicResource AppAccent}"
                BorderBrush="{DynamicResource AppBorderStrong}"
                BorderThickness="1"
                CornerRadius="6"
                Height="80"
                Margin="0,0,0,12" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="HEX" Foreground="{DynamicResource AppMutedForeground}" />
            <TextBlock x:Name="HexText"
                       Grid.Row="0" Grid.Column="1"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       Text="#000000" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="RGB" Foreground="{DynamicResource AppMutedForeground}" />
            <TextBlock x:Name="RgbText"
                       Grid.Row="1" Grid.Column="1"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       Text="0, 0, 0" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="HSL" Foreground="{DynamicResource AppMutedForeground}" />
            <TextBlock x:Name="HslText"
                       Grid.Row="2" Grid.Column="1"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       Text="0°, 0%, 0%" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="APCA" Foreground="{DynamicResource AppMutedForeground}" />
            <TextBlock x:Name="ApcaText"
                       Grid.Row="3" Grid.Column="1"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       TextWrapping="Wrap"
                       Text="vs #FFFFFF: 0 Lc"
                       ToolTip="Accessible Perceptual Contrast Algorithm — designer-grade legibility readout. Targets: ≥75 Lc body text, ≥45 Lc large text." />
        </Grid>

        <TextBlock Grid.Row="3"
                   x:Name="HintText"
                   Foreground="{DynamicResource AppMutedForeground}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,12,0,0">
            <Run Foreground="{DynamicResource AppAccent}" Text="Click anywhere" /> on screen to lock the color and copy HEX to the clipboard. <Run Foreground="{DynamicResource AppAccent}" Text="Esc" /> to dismiss.
        </TextBlock>

        <DockPanel Grid.Row="4" LastChildFill="True">
            <Button x:Name="CopyHexButton"
                    DockPanel.Dock="Right"
                    Content="Copy HEX"
                    Style="{StaticResource AccentButton}"
                    Click="OnCopyHexClicked"
                    Padding="14,6" />
            <Button Content="Close" Click="OnCloseClicked" />
        </DockPanel>
    </Grid>
    </Border>
</Window>
