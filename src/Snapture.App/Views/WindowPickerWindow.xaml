<Window x:Class="Snapture.App.Views.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture Window Picker"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Hand"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid x:Name="RootGrid">
        <Canvas x:Name="OverlayCanvas">
            <Rectangle x:Name="DimRect" Fill="{DynamicResource DimBackdrop}" />
            <Rectangle x:Name="HighlightRect"
                       Stroke="{DynamicResource AppAccent}"
                       StrokeThickness="3"
                       Fill="{DynamicResource SelectionFill}"
                       Visibility="Collapsed" />
            <Border x:Name="TitleBadge"
                    Style="{StaticResource OverlayInfoBadge}"
                    MaxWidth="460"
                    Visibility="Collapsed">
                <TextBlock x:Name="TitleText"
                           Foreground="{DynamicResource AppForeground}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />
            </Border>
            <Border x:Name="HintBadge"
                    Style="{StaticResource OverlayHintBadge}">
                <StackPanel>
                    <TextBlock Text="Window capture" Style="{StaticResource OverlayHintTitleText}" />
                    <TextBlock Text="Click a window to capture it. PgUp/PgDn adjusts the target; Esc cancels."
                               Style="{StaticResource OverlayHintBodyText}" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
