<Window x:Class="Snapture.App.Views.WindowPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture Window Picker"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Hand"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid x:Name="RootGrid">
        <Canvas x:Name="OverlayCanvas">
            <Rectangle x:Name="DimRect" Fill="{DynamicResource DimBackdrop}" />
            <Rectangle x:Name="HighlightRect"
                       Stroke="{DynamicResource AppAccent}"
                       StrokeThickness="3"
                       Fill="{DynamicResource SelectionFill}"
                       Visibility="Collapsed" />
            <Border x:Name="TitleBadge"
                    Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppAccent}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,4"
                    Visibility="Collapsed">
                <TextBlock x:Name="TitleText"
                           Foreground="{DynamicResource AppForeground}"
                           FontSize="13" />
            </Border>
            <Border x:Name="HintBadge"
                    Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,8"
                    Opacity="0.95">
                <TextBlock Foreground="{DynamicResource AppMutedForeground}" FontSize="13">
                    <Run Foreground="{DynamicResource AppAccent}" Text="Click" />
                    <Run Text=" a window to capture " />
                    <Run Foreground="{DynamicResource AppBorderStrong}" Text="·" />
                    <Run Foreground="{DynamicResource AppAccent}" Text=" PgUp/PgDn " />
                    <Run Text="parent/child " />
                    <Run Foreground="{DynamicResource AppBorderStrong}" Text="·" />
                    <Run Foreground="{DynamicResource AppAccent}" Text=" Esc " />
                    <Run Text="cancel" />
                </TextBlock>
            </Border>
        </Canvas>
    </Grid>
</Window>
