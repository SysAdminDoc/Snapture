<Window x:Class="Snapture.App.Views.CapturePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="OnKeyDown">
    <Border Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppBorderStrong}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="8"
            Effect="{StaticResource WindowDropShadow}">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Capture mode"
                       Foreground="{DynamicResource AppMutedForeground}"
                       FontSize="11"
                       FontFamily="{StaticResource UiFont}"
                       Margin="8,4,8,6" />
            <ItemsControl x:Name="ModeList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
