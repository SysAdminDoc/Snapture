<Window x:Class="Snapture.App.Views.CapturePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        KeyDown="OnKeyDown">
    <Border Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppBorderStrong}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10"
            Effect="{StaticResource WindowDropShadow}">
        <StackPanel Orientation="Vertical">
            <TextBlock Text="Choose capture"
                       Style="{StaticResource SectionTitleText}"
                       Foreground="{DynamicResource AppForeground}"
                       Margin="8,4,8,2" />
            <TextBlock Text="Pick the source to capture."
                       Style="{StaticResource HelpText}"
                       FontSize="12"
                       Margin="8,0,8,8" />
            <ItemsControl x:Name="ModeList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
