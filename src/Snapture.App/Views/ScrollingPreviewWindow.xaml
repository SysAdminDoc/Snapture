<Window x:Class="Snapture.App.Views.ScrollingPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture - scrolling capture"
        Width="440" Height="360"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Border Margin="12"
            Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppBorderStrong}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <TextBlock Text="SCROLL CAPTURE"
                           Foreground="{DynamicResource AppAccent}"
                           FontWeight="SemiBold"
                           FontSize="14" />
                <TextBlock x:Name="FrameText"
                           DockPanel.Dock="Right"
                           Foreground="{DynamicResource AppMutedForeground}"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           Text="Waiting for frame" />
            </DockPanel>

            <Border Grid.Row="1"
                    Margin="0,12,0,12"
                    Background="{DynamicResource AppCanvas}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True" />
                    <TextBlock x:Name="EmptyText"
                               Text="Waiting for the first viewport…"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppSubtleForeground}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
                <ProgressBar x:Name="ProgressBar"
                             Height="6"
                             Minimum="0"
                             Maximum="100"
                             Value="0" />
                <TextBlock x:Name="StatusText"
                           Margin="0,7,0,0"
                           Style="{StaticResource HelpText}"
                           Text="Preparing UI Automation scroll…" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
