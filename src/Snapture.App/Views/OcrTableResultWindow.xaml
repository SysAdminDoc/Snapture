<Window x:Class="Snapture.App.Views.OcrTableResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture - OCR table"
        Width="760" Height="520"
        MinWidth="500" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="OCR table"
                           Style="{StaticResource WindowTitleText}"
                           Foreground="{DynamicResource AppAccent}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CountText"
                           Foreground="{DynamicResource AppMutedForeground}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <ScrollViewer x:Name="TableScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="TableGrid" />
            </ScrollViewer>
            <Border x:Name="EmptyState"
                    Style="{StaticResource SectionPanel}"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="No positioned table text found"
                               Style="{StaticResource SectionTitleText}"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock Text="Use an OCR engine with word boxes and capture a table with clear row and column spacing."
                               Style="{StaticResource HelpText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource AppMutedForeground}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyButton"
                            Content="Copy TSV"
                            Style="{StaticResource AccentButton}"
                            Click="OnCopyClicked"
                            Padding="14,6" />
                    <Button Content="Close" Click="OnCloseClicked" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

