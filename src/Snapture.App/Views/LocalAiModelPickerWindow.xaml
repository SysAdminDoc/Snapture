<Window x:Class="Snapture.App.Views.LocalAiModelPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture — Local AI"
        Width="640" Height="540"
        MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <StackPanel>
                <TextBlock Text="Send to local LLM" Style="{StaticResource WindowTitleText}" />
                <TextBlock Text="Choose a discovered local model to inspect the flattened capture."
                           Style="{StaticResource HelpText}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Border Style="{StaticResource SectionPanel}">
                    <StackPanel>
                        <TextBlock Text="Model" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="Only models discovered from Foundry Local, Ollama, or LM Studio are listed."
                                   Style="{StaticResource HelpText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <ComboBox x:Name="ModelCombo"
                                  SelectionChanged="OnModelSelectionChanged" />
                        <TextBlock x:Name="EndpointText"
                                   Style="{StaticResource MonoCaptionText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionPanel}">
                    <StackPanel>
                        <TextBlock Text="Instruction" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="This instruction and the flattened PNG stay on the selected loopback runtime."
                                   Style="{StaticResource HelpText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="PromptBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="92"
                                 Text="Describe this capture concisely. Mention the important visible text, controls, and visual context." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource HelpText}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button Content="Cancel"
                            Click="OnCancelClicked"
                            IsCancel="True" />
                    <Button x:Name="SendButton"
                            Content="Send PNG"
                            Style="{StaticResource AccentButton}"
                            Click="OnSendClicked"
                            IsDefault="True"
                            Padding="18,6" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
