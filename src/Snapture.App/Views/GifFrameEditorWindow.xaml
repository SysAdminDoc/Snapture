<Window x:Class="Snapture.App.Views.GifFrameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture - GIF frame editor"
        Width="920" Height="620"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Frame-by-frame GIF editor" Style="{StaticResource WindowTitleText}" />
            <TextBlock Text="Delete, duplicate, retime, or dither individual frames before saving."
                       Style="{StaticResource HelpText}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource SectionPanel}" Padding="10,8">
            <TextBlock x:Name="SummaryText" Style="{StaticResource MonoCaptionText}" />
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                <ListBox x:Name="FrameList"
                         SelectionChanged="OnFrameSelectionChanged"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3,2,5">
                                <Border Background="{DynamicResource AppCanvas}"
                                        BorderBrush="{DynamicResource AppBorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        Padding="3">
                                    <Image Source="{Binding Preview}"
                                           Width="232"
                                           Height="130"
                                           Stretch="Uniform" />
                                </Border>
                                <DockPanel Margin="3,5,3,0">
                                    <TextBlock Text="{Binding Caption}" />
                                    <TextBlock DockPanel.Dock="Right"
                                               Text="{Binding DelayLabel}"
                                               Style="{StaticResource MonoCaptionText}"
                                               Margin="12,0,0,0" />
                                </DockPanel>
                                <TextBlock Text="{Binding DitherLabel}"
                                           Foreground="{DynamicResource AppAccent}"
                                           FontSize="11"
                                           Margin="3,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SectionPanel}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="PreviewTitle" Text="Select a frame" Style="{StaticResource SectionTitleText}" />
                        <TextBlock x:Name="PreviewDetails" Style="{StaticResource HelpText}" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{DynamicResource AppCanvas}"
                            BorderBrush="{DynamicResource AppBorderStrong}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <Image x:Name="PreviewImage" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="Delay (ms)" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="DelayTextBox" Width="78" HorizontalContentAlignment="Right" />
                            <Button Content="Apply delay" Click="OnApplyDelayClicked" Margin="8,0,0,0" />
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="DeleteButton" Content="Delete" Click="OnDeleteClicked" />
                            <Button x:Name="DuplicateButton" Content="Duplicate" Click="OnDuplicateClicked" />
                            <Button x:Name="DitherButton" Content="Apply dither" Click="OnDitherClicked" />
                        </WrapPanel>
                        <TextBlock x:Name="StatusText"
                                   Style="{StaticResource HelpText}"
                                   Margin="0,8,0,0"
                                   MinHeight="18" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource FooterBar}" Margin="0,14,0,0" Padding="0,10,0,0">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right"
                        Content="Save as GIF"
                        Style="{StaticResource AccentButton}"
                        Click="OnSaveClicked"
                        Padding="14,5" />
                <Button DockPanel.Dock="Right"
                        Content="Cancel"
                        Click="OnCancelClicked"
                        Margin="0,0,8,0"
                        Padding="14,5" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
