<Window x:Class="Snapture.App.Views.SmartCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture Smart Capture"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">
    <Grid x:Name="RootGrid">
        <Canvas x:Name="OverlayCanvas">
            <Rectangle x:Name="DimRect" Fill="{DynamicResource DimBackdrop}" />
            <Rectangle x:Name="HighlightRect"
                       Stroke="{DynamicResource Accent}"
                       StrokeThickness="3"
                       Fill="{DynamicResource SelectionFill}"
                       Visibility="Collapsed" />
            <Border x:Name="DescBadge"
                    Background="{DynamicResource Mantle}"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,4"
                    MaxWidth="520"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ElementType"
                               Foreground="{DynamicResource Mauve}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ElementName"
                               Foreground="{DynamicResource Text}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ElementDims"
                               Foreground="{DynamicResource Subtext}"
                               FontFamily="Cascadia Code, Consolas, monospace"
                               FontSize="11" />
                </StackPanel>
            </Border>
            <Border x:Name="HintBadge"
                    Background="{DynamicResource Mantle}"
                    BorderBrush="{DynamicResource Surface1}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,8">
                <TextBlock Foreground="{DynamicResource Subtext}" FontSize="13">
                    <Run Foreground="{DynamicResource Mauve}" Text="Hover" />
                    <Run Text=" any control to highlight it · " />
                    <Run Foreground="{DynamicResource Mauve}" Text="click" />
                    <Run Text=" to capture · " />
                    <Run Foreground="{DynamicResource Mauve}" Text="PgUp/PgDn" />
                    <Run Text=" walks parent/child · " />
                    <Run Foreground="{DynamicResource Mauve}" Text="Esc" />
                    <Run Text=" cancels" />
                </TextBlock>
            </Border>
        </Canvas>
    </Grid>
</Window>
