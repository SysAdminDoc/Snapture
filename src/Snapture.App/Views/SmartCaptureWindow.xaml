<Window x:Class="Snapture.App.Views.SmartCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture Smart Capture"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">
    <Grid x:Name="RootGrid">
        <Canvas x:Name="OverlayCanvas">
            <Rectangle x:Name="DimRect" Fill="{DynamicResource DimBackdrop}" />
            <Rectangle x:Name="HighlightRect"
                       Stroke="{DynamicResource AppAccent}"
                       StrokeThickness="3"
                       Fill="{DynamicResource SelectionFill}"
                       Visibility="Collapsed" />
            <Border x:Name="DescBadge"
                    Style="{StaticResource OverlayInfoBadge}"
                    MaxWidth="520"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ElementType"
                               Foreground="{DynamicResource AppAccent}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ElementName"
                               Foreground="{DynamicResource AppForeground}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ElementDims"
                               Foreground="{DynamicResource AppMutedForeground}"
                               FontFamily="Cascadia Code, Consolas, monospace"
                               FontSize="11" />
                </StackPanel>
            </Border>
            <Border x:Name="HintBadge"
                    Style="{StaticResource OverlayHintBadge}">
                <StackPanel>
                    <TextBlock Text="Smart element capture" Style="{StaticResource OverlayHintTitleText}" />
                    <TextBlock Text="Hover a control, then click to capture it. PgUp/PgDn refines the target; Esc cancels."
                               Style="{StaticResource OverlayHintBodyText}" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
