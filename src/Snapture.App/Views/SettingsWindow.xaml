<Window x:Class="Snapture.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture - Settings"
        Width="860" Height="680"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Settings"
                           Style="{StaticResource WindowTitleText}" />
                <TextBlock Grid.Row="1"
                           Text="Tune capture, output, privacy, sharing, and diagnostics from one place."
                           Style="{StaticResource HelpText}"
                           Margin="0,4,0,0" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Background="{DynamicResource AppBackground}"
                    BorderThickness="0"
                    Padding="0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Appearance" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Use System to follow the Windows app theme, or force Snapture into a fixed theme."
                                           Style="{StaticResource HelpText}"
                                           Margin="0,0,0,8" />
                                <ComboBox x:Name="ThemeCombo"
                                          Width="240"
                                          HorizontalAlignment="Left">
                                    <ComboBoxItem Tag="system" Content="System" />
                                    <ComboBoxItem Tag="light" Content="Light" />
                                    <ComboBoxItem Tag="dark" Content="Dark" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Startup and capture flow" Style="{StaticResource SectionTitleText}" />
                                <CheckBox x:Name="LaunchAtStartupCheck" Content="Launch Snapture at Windows startup" />
                                <CheckBox x:Name="OpenEditorCheck" Content="Open the editor after each capture" />
                                <CheckBox x:Name="CopyClipboardCheck" Content="Copy each capture to the clipboard" />
                                <CheckBox x:Name="ShowToastCheck" Content="Show a toast when a capture is saved" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Capture">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Capture engine" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Auto chooses the modern WinRT engine when available and falls back when needed."
                                           Style="{StaticResource HelpText}"
                                           Margin="0,0,0,8" />
                                <ComboBox x:Name="EngineCombo"
                                          Width="340"
                                          HorizontalAlignment="Left">
                                    <ComboBoxItem Tag="auto" Content="Auto (recommended)" />
                                    <ComboBoxItem Tag="winrt" Content="WinRT (Windows.Graphics.Capture)" />
                                    <ComboBoxItem Tag="gdi" Content="GDI (legacy)" />
                                </ComboBox>
                                <TextBlock x:Name="EngineCapsText"
                                           Style="{StaticResource HelpText}"
                                           Margin="0,10,0,0" />
                                <CheckBox x:Name="HideDesktopIconsCheck"
                                          Content="Hide desktop icons while capturing"
                                          ToolTip="Temporarily hides the Windows desktop icon list during capture and restores it even if capture fails."
                                          Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="HDR tone mapping" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="When Windows HDR is active, Snapture captures FP16 surfaces and maps them to SDR exports and recordings with this operator. Reinhard is the conservative default."
                                           Style="{StaticResource HelpText}"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap" />
                                <ComboBox x:Name="ToneMapCombo"
                                          Width="260"
                                          HorizontalAlignment="Left">
                                    <ComboBoxItem Tag="reinhard" Content="Reinhard (default)" />
                                    <ComboBoxItem Tag="aces" Content="ACES" />
                                    <ComboBoxItem Tag="hable" Content="Hable" />
                                </ComboBox>
                                <CheckBox x:Name="HdrColorCorrectionCheck"
                                          Content="HDR screenshot color correction (recommended)"
                                          ToolTip="Tone-map HDR highlights for SDR viewers. Turn off to use a direct scRGB clamp; bright highlights may clip."
                                          Margin="0,10,0,0" />
                                <CheckBox x:Name="HdrWriteJxrCheck"
                                          Content="Also write JXR (Game Bar compatibility; SDR-clamped)"
                                          Margin="0,10,0,0" />
                                <Border x:Name="HdrCalibrationPanel"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource AppSurfaceRaised}"
                                        BorderBrush="{DynamicResource AppWarning}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10"
                                        Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="HDR display calibration recommended"
                                                   Foreground="{DynamicResource AppWarning}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock x:Name="HdrCalibrationText"
                                                   Style="{StaticResource HelpText}"
                                                   Margin="0,4,0,8" />
                                        <Button x:Name="OpenHdrCalibrationButton"
                                                Content="Open Windows HDR calibration"
                                                HorizontalAlignment="Left"
                                                Click="OnOpenHdrCalibrationClicked" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="OCR fallback" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Windows AI and Windows OCR remain preferred for regular OCR. Auto-redact uses RapidOCR's shared DBNet text-region path first, with bundled Latin models. An optional OneOCR sidecar can use the Windows Snipping Tool model without sending images to the cloud."
                                           Style="{StaticResource HelpText}"
                                           TextWrapping="Wrap" />
                                <CheckBox x:Name="RapidOcrDirectMlCheck"
                                          Content="Enable DirectML for RapidOCR (experimental)"
                                          ToolTip="Uses DirectML device 0 when the optional provider is available. Snapture falls back to CPU automatically if it is missing or cannot initialize."
                                          Margin="0,10,0,0" />
                                <TextBlock x:Name="RapidOcrStatusText"
                                           Style="{StaticResource MonoCaptionText}"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="OneOCR sidecar (optional)"
                                           Style="{StaticResource SectionTitleText}"
                                           Margin="0,16,0,0" />
                                <TextBlock Text="Choose a user-supplied sponeocr.exe from the community OneOCR pattern. Snapture does not redistribute the Snipping Tool DLLs or model."
                                           Style="{StaticResource HelpText}"
                                           TextWrapping="Wrap" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OneOcrPathBox"
                                             Margin="0,0,8,0"
                                             ToolTip="Leave empty to discover sponeocr.exe beside Snapture or in the Snapture OCR folder." />
                                    <Button Grid.Column="1"
                                            Content="Browse…"
                                            Click="OnBrowseOneOcrClicked" />
                                </Grid>
                                <TextBlock x:Name="OneOcrStatusText"
                                           Style="{StaticResource MonoCaptionText}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Borderless capture" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Windows 11 22H2+ can draw a yellow border around captured windows unless Snapture has borderless-capture access. The consent persists across reinstalls."
                                           Style="{StaticResource HelpText}" />
                                <Button x:Name="RequestBorderlessButton"
                                        Content="Request access"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        Click="OnRequestBorderlessClicked" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="PrintScreen ownership" Style="{StaticResource SectionTitleText}" />
                                <TextBlock x:Name="PrintScreenStatus"
                                           Style="{StaticResource HelpText}" />
                                <Button x:Name="ReclaimPrintScreenButton"
                                        Content="Restore PrintScreen shortcut"
                                        HorizontalAlignment="Left"
                                        Margin="0,10,0,0"
                                        Click="OnReclaimPrintScreenClicked" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="LocalAiTab" Header="AI tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Local AI providers" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Optional local-only model runtimes. Snapture probes loopback addresses only; cloud providers and cloud endpoints are intentionally absent."
                                           Style="{StaticResource HelpText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="RefreshLocalAiButton"
                                            Content="Refresh providers"
                                            Click="OnRefreshLocalAiClicked" />
                                    <TextBlock x:Name="LocalAiStatusText"
                                               Style="{StaticResource MonoCaptionText}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="LocalAiProvidersPanel" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Capture shortcuts" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Click a field, then press the desired modifier combination and one final key."
                                           Style="{StaticResource HelpText}"
                                           Margin="0,0,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Region capture"
                                               Grid.Row="0" Grid.Column="0"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="RegionHotkeyBox"
                                             Grid.Row="0" Grid.Column="1"
                                             IsReadOnly="True"
                                             Text="PrintScreen"
                                             PreviewKeyDown="OnHotkeyPreviewKeyDown"
                                             Tag="region"
                                             Margin="0,0,0,8" />

                                    <TextBlock Text="Window capture"
                                               Grid.Row="1" Grid.Column="0"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="WindowHotkeyBox"
                                             Grid.Row="1" Grid.Column="1"
                                             IsReadOnly="True"
                                             Text="Alt+PrintScreen"
                                             PreviewKeyDown="OnHotkeyPreviewKeyDown"
                                             Tag="window"
                                             Margin="0,0,0,8" />

                                    <TextBlock Text="Fullscreen capture"
                                               Grid.Row="2" Grid.Column="0"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="FullscreenHotkeyBox"
                                             Grid.Row="2" Grid.Column="1"
                                             IsReadOnly="True"
                                             Text="Ctrl+PrintScreen"
                                             PreviewKeyDown="OnHotkeyPreviewKeyDown"
                                             Tag="fullscreen"
                                             Margin="0,0,0,8" />

                                    <TextBlock Text="Last-region recapture"
                                               Grid.Row="3" Grid.Column="0"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="LastRegionHotkeyBox"
                                             Grid.Row="3" Grid.Column="1"
                                             IsReadOnly="True"
                                             Text="Shift+PrintScreen"
                                             PreviewKeyDown="OnHotkeyPreviewKeyDown"
                                             Tag="lastRegion" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Output">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Capture preset" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Apply a local template for bug reports, code, documentation, or LAN sharing. You can fine-tune any field below before saving."
                                           Style="{StaticResource HelpText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CapturePresetCombo"
                                              SelectionChanged="OnCapturePresetSelectionChanged">
                                        <ComboBoxItem Tag="custom" Content="Custom" />
                                        <ComboBoxItem Tag="bug-report" Content="Bug-report" />
                                        <ComboBoxItem Tag="code-block" Content="Code-block" />
                                        <ComboBoxItem Tag="documentation" Content="Documentation" />
                                        <ComboBoxItem Tag="quick-share-lan" Content="Quick-share-LAN" />
                                    </ComboBox>
                                    <Button Grid.Column="1"
                                            Content="Apply preset"
                                            Click="OnApplyPresetClicked"
                                            ToolTip="Apply the selected local capture template to the draft settings." />
                                </Grid>
                                <TextBlock x:Name="CapturePresetDescriptionText"
                                           Style="{StaticResource MonoCaptionText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Output folder" Style="{StaticResource SectionTitleText}" />
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="BrowseFolderButton"
                                            DockPanel.Dock="Right"
                                            Content="Browse"
                                            Click="OnBrowseFolderClicked"
                                            Margin="8,0,0,0" />
                                    <TextBox x:Name="OutputFolderBox" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Filename template" Style="{StaticResource SectionTitleText}" />
                                <TextBox x:Name="FilenameTemplateBox" />
                                <TextBlock Style="{StaticResource MonoCaptionText}"
                                           Margin="0,10,0,0">
                                    Placeholders inside <Run Foreground="{DynamicResource AppAccent}" Text="{}{ }" />
                                    use .NET DateTime format strings:
                                    <LineBreak />
                                    <Run Foreground="{DynamicResource Yellow}" Text="{}{yyyy-MM-dd}" /> - date
                                    <LineBreak />
                                    <Run Foreground="{DynamicResource Yellow}" Text="{}{HH-mm-ss}" /> - time
                                    <LineBreak />
                                    <Run Foreground="{DynamicResource Yellow}" Text="{}{yyyy}" /> - year
                                    <LineBreak />
                                    <Run Foreground="{DynamicResource Yellow}" Text="{}{MMM}" /> - month name
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Default format" Style="{StaticResource SectionTitleText}" />
                                <ComboBox x:Name="FormatCombo"
                                          Width="220"
                                          HorizontalAlignment="Left">
                                    <ComboBoxItem Tag="PNG" Content="PNG (lossless)" />
                                    <ComboBoxItem Tag="JPG" Content="JPEG (smaller)" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Clipboard integration" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Image keeps the normal PNG clipboard. Markdown copies a relative link and writes the capture PNG into the configured vault folder. Ctrl+Alt+V always runs the Markdown pin for the most recent capture."
                                           Style="{StaticResource HelpText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <ComboBox x:Name="ClipboardModeCombo"
                                          Width="260"
                                          HorizontalAlignment="Left">
                                    <ComboBoxItem Tag="image" Content="Image (default)" />
                                    <ComboBoxItem Tag="markdown" Content="Markdown link" />
                                </ComboBox>
                                <TextBlock Text="Markdown vault or export folder"
                                           Style="{StaticResource SectionTitleText}"
                                           Margin="0,16,0,0" />
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="BrowseMarkdownVaultButton"
                                            DockPanel.Dock="Right"
                                            Content="Browse"
                                            Click="OnBrowseMarkdownVaultClicked"
                                            Margin="8,0,0,0" />
                                    <TextBox x:Name="MarkdownVaultFolderBox"
                                             ToolTip="Obsidian vault root or a Joplin Markdown export folder. Obsidian can be discovered automatically when this is empty." />
                                </DockPanel>
                                <TextBlock Text="Attachment subfolder"
                                           Style="{StaticResource SectionTitleText}"
                                           Margin="0,16,0,0" />
                                <TextBox x:Name="MarkdownAttachmentFolderBox"
                                         ToolTip="Relative folder under the vault, for example attachments or _resources." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Auto-redact">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <TextBlock Text="Rule controls" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Style="{StaticResource HelpText}">
                                Toggle individual detector rules. Disabled rules will not match during the editor's
                                <Run Foreground="{DynamicResource AppAccent}" Text="Auto-redact" />
                                pass. New rules ship enabled; only your disabled set is persisted.
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="RedactEnableAllButton"
                                        Content="Enable all"
                                        Click="OnRedactEnableAllClicked" />
                                <Button x:Name="RedactDisableAllButton"
                                        Content="Disable all"
                                        Click="OnRedactDisableAllClicked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RedactRulesList" />
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="LAN share">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Local share server" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Style="{StaticResource HelpText}">
                                    Local network only. Snapture binds Kestrel to the adapter you choose, serves single-fetch token URLs that expire after the TTL, and never phones home.
                                </TextBlock>
                                <CheckBox x:Name="LanEnableCheck"
                                          Content="Enable LAN share server on app launch"
                                          Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Binding" Style="{StaticResource SectionTitleText}" />
                                <TextBlock Text="Adapter" Style="{StaticResource HelpText}" />
                                <ComboBox x:Name="LanAdapterCombo"
                                          Width="390"
                                          HorizontalAlignment="Left"
                                          Margin="0,4,0,12" />
                                <TextBlock Text="Port" Style="{StaticResource HelpText}" />
                                <TextBox x:Name="LanPortBox" Width="130" HorizontalAlignment="Left" Margin="0,4,0,12" />
                                <TextBlock Text="Token TTL (minutes)" Style="{StaticResource HelpText}" />
                                <TextBox x:Name="LanTtlBox" Width="130" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="LanStartButton"
                                            Content="Start now"
                                            Click="OnLanStartClicked" />
                                    <Button x:Name="LanStopButton"
                                            Content="Stop"
                                            Click="OnLanStopClicked" />
                                </StackPanel>
                                <TextBlock x:Name="LanStatusText"
                                           Style="{StaticResource MonoCaptionText}"
                                           Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Settings file" Style="{StaticResource SectionTitleText}" />
                                <TextBlock x:Name="SettingsPathText"
                                           Style="{StaticResource MonoCaptionText}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Import" Click="OnImportClicked" />
                                    <Button Content="Export" Click="OnExportClicked" />
                                    <Button Content="Reveal in Explorer" Click="OnRevealClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <TextBlock Text="Diagnostics" Style="{StaticResource SectionTitleText}" />
                                <TextBlock x:Name="DiagnosticsText"
                                           Style="{StaticResource MonoCaptionText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource AppMutedForeground}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button x:Name="OkButton"
                            Content="Save"
                            Style="{StaticResource AccentButton}"
                            Click="OnOkClicked"
                            Padding="20,6"
                            IsDefault="True" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Click="OnCancelClicked"
                            IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
