<Window x:Class="Snapture.App.Views.RegionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture Region"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Window.Resources>
        <!--  Cached references so the overlay doesn't pull from app dictionaries every frame  -->
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!--  Image of frozen virtual screen; dimmed by overlay  -->
        <Image x:Name="BackgroundImage"
               Stretch="None"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               SnapsToDevicePixels="True" />

        <!--  Dim layer using OpacityMask trick: full-screen dim, hole punched at selection  -->
        <Canvas x:Name="OverlayCanvas">
            <Rectangle x:Name="DimRect"
                       Width="0"
                       Height="0"
                       Fill="{DynamicResource DimBackdrop}" />
            <Rectangle x:Name="SelectionRect"
                       Stroke="{DynamicResource AppAccent}"
                       StrokeThickness="2"
                       Fill="{DynamicResource SelectionFill}"
                       Visibility="Collapsed"
                       SnapsToDevicePixels="True" />
            <Border x:Name="SizeBadge"
                    Style="{StaticResource OverlayInfoBadge}"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText"
                           Foreground="{DynamicResource AppForeground}"
                           FontSize="12"
                           FontFamily="Cascadia Code, Consolas, monospace" />
            </Border>
            <Border x:Name="LoupeBorder"
                    Width="120" Height="120"
                    Background="{DynamicResource AppSurface}"
                    BorderBrush="{DynamicResource AppAccent}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Visibility="Collapsed"
                    SnapsToDevicePixels="True">
                <Grid ClipToBounds="True">
                    <Image x:Name="LoupeImage" Stretch="None" />
                    <Path Stroke="{DynamicResource AppAccent}" StrokeThickness="1" Data="M 0,60 H 120 M 60,0 V 120" Opacity="0.7" />
                    <TextBlock x:Name="LoupeText"
                               Foreground="{DynamicResource AppForeground}"
                               Background="{DynamicResource AppSurface}"
                               FontFamily="Cascadia Code, Consolas, monospace"
                               FontSize="11"
                               Padding="4,1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,4" />
                </Grid>
            </Border>
            <Border x:Name="HintBadge"
                    Style="{StaticResource OverlayHintBadge}"
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Region capture" Style="{StaticResource OverlayHintTitleText}" />
                    <TextBlock Text="Drag to choose an area. Enter captures; Esc cancels."
                               Style="{StaticResource OverlayHintBodyText}" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
