<Window x:Class="Snapture.App.Views.RegionOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture Region"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Window.Resources>
        <!--  Cached references so the overlay doesn't pull from app dictionaries every frame  -->
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!--  Image of frozen virtual screen; dimmed by overlay  -->
        <Image x:Name="BackgroundImage"
               Stretch="None"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               SnapsToDevicePixels="True" />

        <!--  Dim layer using OpacityMask trick: full-screen dim, hole punched at selection  -->
        <Canvas x:Name="OverlayCanvas">
            <Rectangle x:Name="DimRect"
                       Width="0"
                       Height="0"
                       Fill="{StaticResource DimBackdrop}" />
            <Rectangle x:Name="SelectionRect"
                       Stroke="{StaticResource Accent}"
                       StrokeThickness="2"
                       Fill="{StaticResource SelectionFill}"
                       Visibility="Collapsed"
                       SnapsToDevicePixels="True" />
            <Border x:Name="SizeBadge"
                    Background="{StaticResource Mantle}"
                    BorderBrush="{StaticResource Accent}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6,3"
                    Visibility="Collapsed">
                <TextBlock x:Name="SizeText"
                           Foreground="{StaticResource Text}"
                           FontSize="12"
                           FontFamily="Cascadia Code, Consolas, monospace" />
            </Border>
            <Border x:Name="LoupeBorder"
                    Width="120" Height="120"
                    Background="{StaticResource Mantle}"
                    BorderBrush="{StaticResource Accent}"
                    BorderThickness="2"
                    CornerRadius="60"
                    Visibility="Collapsed"
                    SnapsToDevicePixels="True">
                <Grid ClipToBounds="True">
                    <Image x:Name="LoupeImage" Stretch="None" />
                    <Path Stroke="{StaticResource Accent}" StrokeThickness="1" Data="M 0,60 H 120 M 60,0 V 120" Opacity="0.7" />
                    <TextBlock x:Name="LoupeText"
                               Foreground="{StaticResource Text}"
                               Background="{StaticResource Mantle}"
                               FontFamily="Cascadia Code, Consolas, monospace"
                               FontSize="11"
                               Padding="4,1"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,4" />
                </Grid>
            </Border>
            <Border x:Name="HintBadge"
                    Background="{StaticResource Mantle}"
                    BorderBrush="{StaticResource Surface1}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,8"
                    Opacity="0.95"
                    HorizontalAlignment="Center">
                <TextBlock Foreground="{StaticResource Subtext}" FontSize="13">
                    <Run Foreground="{StaticResource Mauve}" Text="Drag" />
                    <Run Text=" to select region " />
                    <Run Foreground="{StaticResource Surface2}" Text="·" />
                    <Run Foreground="{StaticResource Mauve}" Text=" Esc " />
                    <Run Text="cancel" />
                    <Run Foreground="{StaticResource Surface2}" Text=" · " />
                    <Run Foreground="{StaticResource Mauve}" Text="Enter " />
                    <Run Text="confirm" />
                </TextBlock>
            </Border>
        </Canvas>
    </Grid>
</Window>
