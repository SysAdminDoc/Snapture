<Window x:Class="Snapture.App.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Snapture — Editor"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        Drop="OnDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="56" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="240" />
        </Grid.ColumnDefinitions>

        <!--  Top bar  -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="✦ Snapture Editor"
                               Foreground="{DynamicResource AppAccent}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <Button x:Name="OpenButton" Content="Open…" Click="OnOpenClicked" AutomationProperties.Name="Open file" />
                    <Button x:Name="SaveProjectButton" Content="Save .snapture" Click="OnSaveProjectClicked" AutomationProperties.Name="Save project" />
                    <Separator Margin="6,0" Background="{DynamicResource AppBorder}" />
                    <Button x:Name="ExportButton"
                            Content="Export PNG"
                            Style="{StaticResource AccentButton}"
                            Click="OnExportPngClicked"
                            Padding="14,6" />
                    <Button x:Name="ExportAsButton" Content="Export As…" Click="OnExportAsClicked" AutomationProperties.Name="Export as" />
                    <Button x:Name="CopyButton" Content="Copy" Click="OnCopyClicked" AutomationProperties.Name="Copy to clipboard" />
                    <Button x:Name="PinButton" Content="Pin" Click="OnPinClicked" AutomationProperties.Name="Pin as overlay" />
                    <Separator Margin="6,0" Background="{DynamicResource AppBorder}" />
                    <Button x:Name="RetakeButton" Content="Retake" Click="OnRetakeClicked"
                            ToolTip="Discard and recapture from the same source." Visibility="Collapsed" />
                    <Separator x:Name="RetakeSep" Margin="6,0" Background="{DynamicResource AppBorder}" Visibility="Collapsed" />
                    <Button x:Name="AutoRedactButton"
                            Content="Auto-redact secrets"
                            Click="OnAutoRedactClicked"
                            ToolTip="Run OCR + Gitleaks rule pack and add solid-fill redactions to detected API keys, JWTs, AWS keys, JWTs, IPs, etc." />
                    <Button x:Name="ShareLanButton"
                            Content="Share to LAN"
                            Click="OnShareLanClicked"
                            ToolTip="Save the current document and copy a single-fetch LAN URL to the clipboard." />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button x:Name="UndoButton" Content="↶ Undo" Click="OnUndoClicked" AutomationProperties.Name="Undo" />
                    <Button x:Name="RedoButton" Content="↷ Redo" Click="OnRedoClicked" AutomationProperties.Name="Redo" />
                    <TextBlock x:Name="DimensionText"
                               Foreground="{DynamicResource AppMutedForeground}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Tool palette (left rail)  -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,1,0"
                Padding="6,12">
            <StackPanel x:Name="ToolStack" />
        </Border>

        <!--  Canvas  -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource AppCanvas}"
                Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent">
                <skia:SKElement x:Name="Canvas"
                                PaintSurface="OnPaintSurface"
                                MouseDown="OnCanvasMouseDown"
                                MouseMove="OnCanvasMouseMove"
                                MouseUp="OnCanvasMouseUp"
                                MouseWheel="OnCanvasMouseWheel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20" />
            </ScrollViewer>
        </Border>

        <!--  Right panel: properties + adjustments  -->
        <Border Grid.Row="1"
                Grid.Column="2"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1,0,0,0"
                Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Style"
                               Foreground="{DynamicResource AppAccent}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <TextBlock Text="Color" Foreground="{DynamicResource AppMutedForeground}" Margin="0,4,0,4" />
                    <UniformGrid x:Name="ColorPalette" Columns="6" />

                    <TextBlock Text="Recent" Foreground="{DynamicResource AppMutedForeground}" Margin="0,8,0,4" />
                    <UniformGrid x:Name="RecentColors" Columns="6" Height="24" />

                    <DockPanel Margin="0,8,0,4">
                        <TextBlock Text="Saved" Foreground="{DynamicResource AppMutedForeground}" VerticalAlignment="Center" />
                        <Button Content="+ Save" FontSize="10" Padding="4,1" Margin="6,0,0,0"
                                Click="OnSaveSwatchClicked" VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid x:Name="SavedSwatches" Columns="6" />

                    <TextBlock Text="Opacity" Foreground="{DynamicResource AppMutedForeground}" Margin="0,12,0,4" />
                    <Slider x:Name="OpacitySlider"
                            Minimum="0" Maximum="255"
                            Value="255"
                            ValueChanged="OnOpacityChanged"
                            ToolTip="Adjust color opacity (alpha channel)" />

                    <TextBlock Text="Stroke" Foreground="{DynamicResource AppMutedForeground}" Margin="0,12,0,4" />
                    <Slider x:Name="StrokeSlider"
                            Minimum="1" Maximum="24"
                            Value="3"
                            ValueChanged="OnStrokeChanged" />

                    <CheckBox x:Name="DashedCheck"
                              Content="Dashed line/arrow"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,8,0,0" />
                    <CheckBox x:Name="BidirCheck"
                              Content="Bidirectional arrow"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,4,0,0" />
                    <CheckBox x:Name="ReversedCheck"
                              Content="Reversed arrow direction"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,4,0,0" />
                    <CheckBox x:Name="FilledCheck"
                              Content="Filled rectangle/ellipse"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,4,0,0" />
                    <CheckBox x:Name="PixelateCheck"
                              Content="Pixelate (instead of blur)"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,4,0,0" />
                    <CheckBox x:Name="DropShadowCheck"
                              Content="Drop shadow on shapes"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,4,0,0" />

                    <TextBlock Text="Adjustments"
                               Foreground="{DynamicResource AppAccent}"
                               FontWeight="SemiBold"
                               Margin="0,16,0,6" />
                    <TextBlock Text="Brightness" Foreground="{DynamicResource AppMutedForeground}" />
                    <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnAdjustmentChanged" />
                    <TextBlock Text="Contrast" Foreground="{DynamicResource AppMutedForeground}" Margin="0,4,0,0" />
                    <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnAdjustmentChanged" />
                    <CheckBox x:Name="GrayscaleCheck"
                              Content="Grayscale"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,8,0,0"
                              Click="OnAdjustmentClicked" />
                    <CheckBox x:Name="InvertCheck"
                              Content="Invert"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,4,0,0"
                              Click="OnAdjustmentClicked" />

                    <TextBlock Text="Frame"
                               Foreground="{DynamicResource AppAccent}"
                               FontWeight="SemiBold"
                               Margin="0,16,0,6" />
                    <CheckBox x:Name="ShadowCheck"
                              Content="Drop shadow"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Click="OnFrameClicked" />
                    <CheckBox x:Name="RoundedCheck"
                              Content="Rounded corners"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,4,0,0"
                              Click="OnFrameClicked" />
                    <CheckBox x:Name="GradientCheck"
                              Content="Gradient backdrop"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,4,0,0"
                              Click="OnFrameClicked" />
                    <CheckBox x:Name="CodeChromeCheck"
                              Content="Code window chrome (Carbon-style)"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,4,0,0"
                              ToolTip="Wraps the image in a macOS-style window with red / yellow / green traffic-light dots."
                              Click="OnFrameClicked" />
                    <CheckBox x:Name="BeautifierCheck"
                              Content="Background Beautifier"
                              Foreground="{DynamicResource AppMutedForeground}"
                              Margin="0,4,0,0"
                              ToolTip="Adds margin, rounded corners, and a gradient backdrop for polished screenshots."
                              Click="OnFrameClicked" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Status bar  -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource AppMutedForeground}"
                           DockPanel.Dock="Left" />
                <TextBlock x:Name="PathText"
                           Foreground="{DynamicResource AppSubtleForeground}"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
