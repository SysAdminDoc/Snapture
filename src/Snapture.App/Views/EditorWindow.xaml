<Window x:Class="Snapture.App.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture — Editor"
        Width="1100" Height="720"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Base}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Toolbar  -->
        <Border Grid.Row="0"
                Background="{StaticResource Mantle}"
                BorderBrush="{StaticResource Surface0}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="✦ Snapture"
                               Foreground="{StaticResource Mauve}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0" />
                    <Button x:Name="SaveButton"
                            Content="Save"
                            Style="{StaticResource AccentButton}"
                            Click="OnSaveClicked"
                            Padding="14,6" />
                    <Button x:Name="SaveAsButton" Content="Save As…" Click="OnSaveAsClicked" />
                    <Button x:Name="CopyButton" Content="Copy" Click="OnCopyClicked" />
                    <Button x:Name="PinButton" Content="Pin to Desktop" Click="OnPinClicked" />
                    <Button x:Name="OpenFolderButton" Content="Show in Folder" Click="OnOpenFolderClicked" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <TextBlock x:Name="DimensionText"
                               Foreground="{StaticResource Subtext}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <Button x:Name="CloseButton" Content="Close" Click="OnCloseClicked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  Image canvas  -->
        <Border Grid.Row="1" Background="{StaticResource Crust}" Padding="12">
            <Grid>
                <Border Background="#0FFFFFFF"
                        BorderBrush="{StaticResource Surface0}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent">
                        <Image x:Name="CapturedImage"
                               Stretch="None"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="20" />
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!--  Status bar  -->
        <Border Grid.Row="2"
                Background="{StaticResource Mantle}"
                BorderBrush="{StaticResource Surface0}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           Foreground="{StaticResource Subtext}"
                           DockPanel.Dock="Left" />
                <TextBlock x:Name="PathText"
                           Foreground="{StaticResource Overlay1}"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
