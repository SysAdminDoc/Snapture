<Window x:Class="Snapture.App.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="Snapture — Editor"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        Drop="OnDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!--  Top bar  -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource HeaderBar}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Snapture Editor"
                           Style="{StaticResource WindowTitleText}"
                           Foreground="{DynamicResource AppAccent}"
                           Margin="0,0,14,0" />

                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal">
                    <Button x:Name="OpenButton" Content="Open" Click="OnOpenClicked" AutomationProperties.Name="Open file" />
                    <Button x:Name="SaveProjectButton" Content="Save project" Click="OnSaveProjectClicked" AutomationProperties.Name="Save project" />
                    <Separator Margin="6,0" Background="{DynamicResource AppBorder}" />
                    <Button x:Name="ExportButton"
                            Content="Export PNG"
                            Style="{StaticResource AccentButton}"
                            Click="OnExportPngClicked"
                            Padding="14,6" />
                    <Button x:Name="ExportAsButton" Content="Export as" Click="OnExportAsClicked" AutomationProperties.Name="Export as" />
                    <Button x:Name="CopyButton" Content="Copy" Click="OnCopyClicked" AutomationProperties.Name="Copy to clipboard" />
                    <Button x:Name="PinButton" Content="Pin" Click="OnPinClicked" AutomationProperties.Name="Pin as overlay" />
                    <Separator Margin="6,0" Background="{DynamicResource AppBorder}" />
                    <Button x:Name="RetakeButton" Content="Retake" Click="OnRetakeClicked"
                            ToolTip="Retake the capture. Hold Shift while clicking to refresh the background and keep annotations." Visibility="Collapsed" />
                    <Separator x:Name="RetakeSep" Margin="6,0" Background="{DynamicResource AppBorder}" Visibility="Collapsed" />
                    <Button x:Name="AutoRedactButton"
                            Content="Auto-redact"
                            Click="OnAutoRedactClicked"
                            ToolTip="Run OCR and the local rule pack, then add solid redactions for detected secrets." />
                    <Button x:Name="ShareLanButton"
                            Content="LAN share"
                            Click="OnShareLanClicked"
                            ToolTip="Save the current document and copy a single-fetch LAN URL to the clipboard." />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="12,0,0,0">
                    <Button x:Name="UndoButton" Content="Undo" Click="OnUndoClicked" AutomationProperties.Name="Undo" />
                    <Button x:Name="RedoButton" Content="Redo" Click="OnRedoClicked" AutomationProperties.Name="Redo" />
                    <TextBlock x:Name="DimensionText"
                               Foreground="{DynamicResource AppMutedForeground}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Tool palette (left rail)  -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="0,0,1,0"
                Padding="8,12">
            <StackPanel x:Name="ToolStack" />
        </Border>

        <!--  Canvas  -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="{DynamicResource AppCanvas}"
                Padding="16">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent">
                <skia:SKElement x:Name="Canvas"
                                PaintSurface="OnPaintSurface"
                                MouseDown="OnCanvasMouseDown"
                                MouseMove="OnCanvasMouseMove"
                                MouseUp="OnCanvasMouseUp"
                                MouseRightButtonDown="OnCanvasRightMouseDown"
                                MouseWheel="OnCanvasMouseWheel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="20" />
            </ScrollViewer>
        </Border>

        <!--  Right panel: properties + adjustments  -->
        <Border Grid.Row="1"
                Grid.Column="2"
                Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppBorder}"
                BorderThickness="1,0,0,0"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <TextBlock Text="Style" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Color" Style="{StaticResource HelpText}" Margin="0,2,0,5" />
                            <TextBlock Text="Right-click the canvas or a shape for the colour wheel."
                                       Style="{StaticResource HelpText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <UniformGrid x:Name="ColorPalette" Columns="6" />

                            <TextBlock Text="Recent" Style="{StaticResource HelpText}" Margin="0,10,0,5" />
                            <UniformGrid x:Name="RecentColors" Columns="6" Height="24" />

                            <DockPanel Margin="0,10,0,5">
                                <TextBlock Text="Saved" Style="{StaticResource HelpText}" VerticalAlignment="Center" />
                                <Button Content="Save swatch"
                                        FontSize="11"
                                        Padding="8,3"
                                        Margin="8,0,0,0"
                                        Click="OnSaveSwatchClicked"
                                        VerticalAlignment="Center" />
                            </DockPanel>
                            <UniformGrid x:Name="SavedSwatches" Columns="6" />

                            <TextBlock Text="Opacity" Style="{StaticResource HelpText}" Margin="0,14,0,4" />
                            <Slider x:Name="OpacitySlider"
                                    Minimum="0" Maximum="255"
                                    Value="255"
                                    ValueChanged="OnOpacityChanged"
                                    ToolTip="Adjust color opacity." />

                            <TextBlock Text="Stroke" Style="{StaticResource HelpText}" Margin="0,12,0,4" />
                            <Slider x:Name="StrokeSlider"
                                    Minimum="1" Maximum="24"
                                    Value="3"
                                    ValueChanged="OnStrokeChanged" />

                            <DockPanel Margin="0,12,0,4">
                                <TextBlock Text="Sloppiness" Style="{StaticResource HelpText}" />
                                <TextBlock x:Name="SloppinessValue"
                                           Text="0%"
                                           Style="{StaticResource HelpText}"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <Slider x:Name="SloppinessSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"
                                    ValueChanged="OnSloppinessChanged"
                                    ToolTip="Add deterministic hand-drawn wobble to new stroke shapes." />

                            <StackPanel x:Name="ArrowOptionsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Text="Arrow style" Style="{StaticResource HelpText}" Margin="0,0,0,4" />
                                <ComboBox x:Name="ArrowStyleCombo"
                                          SelectedIndex="0"
                                          SelectionChanged="OnArrowStyleChanged"
                                          ToolTip="Classic uses a filled triangle; Modern uses a rounded open chevron.">
                                    <ComboBoxItem Content="Classic" Tag="Classic" />
                                    <ComboBoxItem Content="Modern" Tag="Modern" />
                                </ComboBox>
                                <DockPanel Margin="0,10,0,4">
                                    <TextBlock Text="Curve" Style="{StaticResource HelpText}" />
                                    <TextBlock x:Name="ArrowCurveValue"
                                               Text="0%"
                                               Style="{StaticResource HelpText}"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="ArrowCurveSlider"
                                        Minimum="-100"
                                        Maximum="100"
                                        Value="0"
                                        ValueChanged="OnArrowCurveChanged"
                                        ToolTip="Bend the arrow left or right along a smooth quadratic curve." />
                            </StackPanel>

                            <StackPanel x:Name="TextOptionsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <TextBlock Text="Text direction" Style="{StaticResource HelpText}" Margin="0,0,0,4" />
                                <ComboBox x:Name="TextOrientationCombo"
                                          SelectedIndex="0"
                                          SelectionChanged="OnTextOrientationChanged"
                                          ToolTip="Choose horizontal or vertical text for new annotations.">
                                    <ComboBoxItem Content="Horizontal" Tag="Horizontal" />
                                    <ComboBoxItem Content="Vertical" Tag="Vertical" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="BalloonOptionsPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Corner radius" Style="{StaticResource HelpText}" />
                                    <TextBlock x:Name="BalloonCornerRadiusValue"
                                               Text="16px"
                                               Style="{StaticResource HelpText}"
                                               HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="BalloonCornerRadiusSlider"
                                        Minimum="0"
                                        Maximum="64"
                                        Value="16"
                                        ValueChanged="OnBalloonCornerRadiusChanged"
                                        ToolTip="Round the speech balloon body corners; the tail stays crisp." />
                            </StackPanel>

                            <CheckBox x:Name="DashedCheck" Content="Dashed line or arrow" Margin="0,10,0,0" />
                            <CheckBox x:Name="BidirCheck" Content="Arrowheads at both ends" />
                            <CheckBox x:Name="ReversedCheck" Content="Reverse arrow direction" />
                            <CheckBox x:Name="FilledCheck" Content="Fill rectangles and ellipses" />
                            <CheckBox x:Name="PixelateCheck" Content="Pixelate blur regions" />
                            <CheckBox x:Name="DropShadowCheck" Content="Shape shadow" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionPanel}">
                        <StackPanel>
                            <TextBlock Text="Image" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Brightness" Style="{StaticResource HelpText}" />
                            <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnAdjustmentChanged" />
                            <TextBlock Text="Contrast" Style="{StaticResource HelpText}" Margin="0,8,0,0" />
                            <Slider x:Name="ContrastSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnAdjustmentChanged" />
                            <CheckBox x:Name="GrayscaleCheck"
                                      Content="Grayscale"
                                      Margin="0,10,0,0"
                                      Click="OnAdjustmentClicked" />
                            <CheckBox x:Name="InvertCheck"
                                      Content="Invert colors"
                                      Click="OnAdjustmentClicked" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionPanel}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Frame" Style="{StaticResource SectionTitleText}" />
                            <TextBlock Text="Export-ready wrappers for cleaner screenshots." Style="{StaticResource HelpText}" Margin="0,0,0,6" />
                            <CheckBox x:Name="ShadowCheck" Content="Drop shadow" Click="OnFrameClicked" />
                            <CheckBox x:Name="RoundedCheck" Content="Rounded corners" Click="OnFrameClicked" />
                            <CheckBox x:Name="GradientCheck" Content="Gradient backdrop" Click="OnFrameClicked" />
                            <CheckBox x:Name="CodeChromeCheck"
                                      Content="Code window chrome"
                                      ToolTip="Wraps the image in a compact code-window frame on export."
                                      Click="OnFrameClicked" />
                            <CheckBox x:Name="BeautifierCheck"
                                      Content="Background beautifier"
                                      ToolTip="Adds margin, corners, and a gradient backdrop for polished screenshots."
                                      Click="OnFrameClicked" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--  Status bar  -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Style="{StaticResource FooterBar}"
                Padding="14,7">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource AppMutedForeground}"
                           DockPanel.Dock="Left" />
                <TextBlock x:Name="PathText"
                           Foreground="{DynamicResource AppSubtleForeground}"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
