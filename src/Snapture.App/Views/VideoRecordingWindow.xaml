<Window x:Class="Snapture.App.Views.VideoRecordingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture — Video recording"
        Width="340" Height="180"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="{DynamicResource AppSurface}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True">
            <Ellipse x:Name="RecDot" Width="12" Height="12" Fill="{DynamicResource AppDestructive}" Margin="0,0,8,0">
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1.0" To="0.3" Duration="0:0:0.6" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <TextBlock x:Name="StatusLabel"
                       Text="REC"
                       Foreground="{DynamicResource AppDestructive}"
                       FontWeight="SemiBold"
                       FontSize="14" />
        </DockPanel>
        <TextBlock x:Name="ProgressText"
                   Grid.Row="1"
                   Foreground="{DynamicResource AppMutedForeground}"
                   FontFamily="Cascadia Code, Consolas, monospace"
                   Margin="0,8,0,0"
                   Text="0 frames · 00:00.00 · MP4" />
        <TextBlock x:Name="FormatText"
                   Grid.Row="2"
                   Foreground="{DynamicResource AppSubtleForeground}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Text="Recording to MP4. Frames stream to disk — safe to record long sessions." />
        <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,8,0,0">
            <Button x:Name="StopButton"
                    DockPanel.Dock="Right"
                    Content="Stop &amp; save"
                    Style="{StaticResource AccentButton}"
                    Click="OnStopClicked"
                    Padding="12,4" />
            <Button x:Name="PauseButton"
                    DockPanel.Dock="Right"
                    Content="Pause"
                    Click="OnPauseClicked"
                    Margin="0,0,6,0"
                    Padding="12,4" />
            <Button x:Name="DiscardButton"
                    DockPanel.Dock="Right"
                    Content="Discard"
                    Click="OnDiscardClicked"
                    Margin="0,0,6,0" />
        </DockPanel>
    </Grid>
</Window>
