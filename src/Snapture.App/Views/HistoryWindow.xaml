<Window x:Class="Snapture.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture — Capture History"
        Width="980" Height="640"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0"
                           Orientation="Horizontal">
                    <TextBlock Text="Capture History"
                               Style="{StaticResource WindowTitleText}"
                               Foreground="{DynamicResource AppAccent}"
                               VerticalAlignment="Center"
                               Margin="0,0,18,0" />
                    <TextBox x:Name="SearchBox"
                             Width="310"
                             KeyUp="OnSearchKey"
                             ToolTip="Full-text search over OCR text + window title + process name. SQLite FTS5 syntax allowed." />
                    <ComboBox x:Name="AppFilter"
                              Width="160"
                              Margin="8,0,0,0"
                              SelectionChanged="OnFilterChanged"
                              ToolTip="Filter by source application" />
                    <ComboBox x:Name="DateFilter"
                              Width="110"
                              Margin="8,0,0,0"
                              SelectionChanged="OnFilterChanged"
                              ToolTip="Filter by date range" />
                </WrapPanel>
                <WrapPanel Grid.Row="1"
                           Margin="0,10,0,0"
                           Orientation="Horizontal">
                        <TextBlock Text="Color similarity"
                                   Foreground="{DynamicResource AppMutedForeground}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox x:Name="ColorSearchBox"
                                 Width="100"
                                 ToolTip="Enter a dominant RGB color such as #CBA6F7. Results use a local color-distance match." />
                        <Button Content="Find color"
                                Click="OnColorSearchClicked"
                                ToolTip="Find captures with a similar dominant color." />
                        <Button x:Name="NearDuplicateButton"
                                Content="Near duplicates"
                                Click="OnNearDuplicatesClicked"
                                ToolTip="Show entries whose perceptual hashes are within six bits." />
                        <Button Content="Clear feature filters"
                                Click="OnClearFeatureFiltersClicked"
                                ToolTip="Clear color and near-duplicate filters." />
                        <Button x:Name="VerifiedRedactedButton"
                                Content="Verified-redacted only"
                                Click="OnVerifiedRedactedClicked"
                                ToolTip="Show captures whose Auto-redact result was saved to disk." />
                        <Button x:Name="OcrAllButton"
                                Content="OCR all"
                                Click="OnOcrAllClicked"
                                ToolTip="Run OCR on every entry that hasn't been indexed yet." />
                        <TextBlock x:Name="StatusText"
                                   Foreground="{DynamicResource AppMutedForeground}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="14,0,8,0" />
                </WrapPanel>
                <WrapPanel Grid.Row="2"
                           Orientation="Horizontal"
                           Margin="0,10,0,0">
                    <TextBlock Text="Project"
                               Foreground="{DynamicResource AppMutedForeground}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="ProjectFilter"
                              Width="180"
                              DisplayMemberPath="Name"
                              SelectionChanged="OnProjectFilterChanged"
                              ToolTip="Filter the history wall by project." />
                    <Button Content="New project"
                            Click="OnNewProjectClicked"
                            ToolTip="Create a local project for organizing selected captures." />
                    <Button Content="Move selected"
                            Click="OnMoveSelectedClicked"
                            ToolTip="Assign selected history cards to the chosen project." />
                    <Button Content="Unassign"
                            Click="OnUnassignSelectedClicked"
                            ToolTip="Move selected captures back to the unassigned inbox." />
                    <Button Content="Backup library"
                            Click="OnBackupLibraryClicked"
                            ToolTip="Export the history database, projects, and image files to one .snapture-library archive." />
                    <Button Content="Restore library"
                            Click="OnRestoreLibraryClicked"
                            ToolTip="Import a .snapture-library archive into this history without moving existing files." />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource AppCanvas}">
            <ListView x:Name="HistoryList"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="8"
                      SelectionMode="Extended"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="OnRowDoubleClick">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource AppSurface}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="6"
                                Padding="8"
                                Width="230">
                            <StackPanel>
                                <Border Background="{DynamicResource AppCanvas}"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Height="128"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="{x:Type Image}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="File unavailable"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HelpText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding TitleLine}"
                                           Foreground="{DynamicResource AppForeground}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SubLine}"
                                           Foreground="{DynamicResource AppMutedForeground}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ProjectLine}"
                                           Foreground="{DynamicResource AppAccent}"
                                           FontSize="11"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding VerificationLine}"
                                           Foreground="{DynamicResource AppGreen}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVerifiedRedacted}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding TimeLine}"
                                           Foreground="{DynamicResource AppSubtleForeground}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,5,0,0">
                                    <Border Width="12"
                                            Height="12"
                                            CornerRadius="2"
                                            BorderBrush="{DynamicResource AppBorderStrong}"
                                            BorderThickness="1"
                                            Background="{Binding DominantColorBrush}"
                                            ToolTip="Dominant color sampled locally from this image." />
                                    <TextBlock Text="{Binding FeatureLine}"
                                               Foreground="{DynamicResource AppSubtleForeground}"
                                               FontSize="10"
                                               Margin="6,0,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="Local dominant-color and perceptual-hash metadata." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open in editor" Click="OnOpenInEditor" />
                        <MenuItem Header="Pin"             Click="OnPinSelected" />
                        <MenuItem Header="Run OCR"         Click="OnRunOcr" />
                        <MenuItem Header="Reveal in folder" Click="OnRevealInFolder" />
                        <MenuItem Header="Send to LAN share"  Click="OnSendToLanShare" />
                        <Separator />
                        <MenuItem Header="Delete from history" Click="OnDeleteSelected" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <Border x:Name="EmptyState"
                    Style="{StaticResource SectionPanel}"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="No captures found"
                               Style="{StaticResource SectionTitleText}"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock Text="New captures appear here automatically. Try clearing search or filters if you expected existing results."
                               Style="{StaticResource HelpText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource FooterBar}"
                Padding="14,8">
            <TextBlock x:Name="DbPathText"
                       Foreground="{DynamicResource AppSubtleForeground}"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>
