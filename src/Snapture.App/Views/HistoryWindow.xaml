<Window x:Class="Snapture.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture — Capture History"
        Width="980" Height="640"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource HeaderBar}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="Capture History"
                           Style="{StaticResource WindowTitleText}"
                           Foreground="{DynamicResource AppAccent}"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0"
                           DockPanel.Dock="Left" />
                <TextBox x:Name="SearchBox"
                         DockPanel.Dock="Left"
                         Width="310"
                         KeyUp="OnSearchKey"
                         ToolTip="Full-text search over OCR text + window title + process name. SQLite FTS5 syntax allowed." />
                <ComboBox x:Name="AppFilter"
                          DockPanel.Dock="Left"
                          Width="160"
                          Margin="8,0,0,0"
                          SelectionChanged="OnFilterChanged"
                          ToolTip="Filter by source application" />
                <ComboBox x:Name="DateFilter"
                          DockPanel.Dock="Left"
                          Width="110"
                          Margin="8,0,0,0"
                          SelectionChanged="OnFilterChanged"
                          ToolTip="Filter by date range" />
                <Button x:Name="OcrAllButton"
                        DockPanel.Dock="Right"
                        Content="OCR all"
                        Click="OnOcrAllClicked"
                        ToolTip="Run OCR on every entry that hasn't been indexed yet." />
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource AppMutedForeground}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Margin="14,0,8,0" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource AppCanvas}">
            <ListView x:Name="HistoryList"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="8"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="OnRowDoubleClick">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource AppSurface}"
                                BorderBrush="{DynamicResource AppBorder}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="6"
                                Padding="8"
                                Width="230">
                            <StackPanel>
                                <Border Background="{DynamicResource AppCanvas}"
                                        BorderBrush="{DynamicResource AppBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Height="128"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}"
                                               Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="{x:Type Image}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Text="File unavailable"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource HelpText}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding TitleLine}"
                                           Foreground="{DynamicResource AppForeground}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SubLine}"
                                           Foreground="{DynamicResource AppMutedForeground}"
                                           FontSize="11"
                                           Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TimeLine}"
                                           Foreground="{DynamicResource AppSubtleForeground}"
                                           FontSize="11"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open in editor" Click="OnOpenInEditor" />
                        <MenuItem Header="Pin"             Click="OnPinSelected" />
                        <MenuItem Header="Run OCR"         Click="OnRunOcr" />
                        <MenuItem Header="Reveal in folder" Click="OnRevealInFolder" />
                        <MenuItem Header="Send to LAN share"  Click="OnSendToLanShare" />
                        <Separator />
                        <MenuItem Header="Delete from history" Click="OnDeleteSelected" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <Border x:Name="EmptyState"
                    Style="{StaticResource SectionPanel}"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="No captures found"
                               Style="{StaticResource SectionTitleText}"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock Text="New captures appear here automatically. Try clearing search or filters if you expected existing results."
                               Style="{StaticResource HelpText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource FooterBar}"
                Padding="14,8">
            <TextBlock x:Name="DbPathText"
                       Foreground="{DynamicResource AppSubtleForeground}"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>
