<Window x:Class="Snapture.App.Views.BarcodeResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture - QR and barcode results"
        Width="720" Height="500"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="QR and barcode results"
                           Style="{StaticResource WindowTitleText}"
                           Foreground="{DynamicResource AppAccent}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="CountText"
                           Foreground="{DynamicResource AppMutedForeground}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SectionPanel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Format}"
                                               Style="{StaticResource SectionTitleText}"
                                               VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{DynamicResource AppForeground}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Cascadia Code, Consolas, monospace" />
                                        <TextBlock Text="{Binding Bounds}"
                                                   Style="{StaticResource MonoCaptionText}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border x:Name="EmptyState"
                    Style="{StaticResource SectionPanel}"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="No QR code or barcode found"
                               Style="{StaticResource SectionTitleText}"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock Text="Try a larger crop with more contrast and a clear quiet zone around the code."
                               Style="{StaticResource HelpText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource AppMutedForeground}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CopyButton"
                            Content="Copy results"
                            Style="{StaticResource AccentButton}"
                            Click="OnCopyClicked"
                            Padding="14,6" />
                    <Button Content="Close" Click="OnCloseClicked" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
