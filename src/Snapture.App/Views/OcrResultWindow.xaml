<Window x:Class="Snapture.App.Views.OcrResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture - OCR result"
        Width="640" Height="480"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource HeaderBar}">
            <DockPanel LastChildFill="True">
                <TextBlock Text="OCR Result"
                           Style="{StaticResource WindowTitleText}"
                           Foreground="{DynamicResource AppAccent}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <TextBlock x:Name="LangText"
                           Foreground="{DynamicResource AppMutedForeground}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           DockPanel.Dock="Right" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <TextBox x:Name="ResultBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Code, Consolas, monospace"
                     FontSize="13"
                     Background="{DynamicResource AppSurface}"
                     BorderBrush="{DynamicResource AppBorder}"
                     BorderThickness="1"
                     Padding="12" />
            <Border x:Name="EmptyState"
                    Style="{StaticResource SectionPanel}"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="No text recognized"
                               Style="{StaticResource SectionTitleText}"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock Text="Try a larger region, higher-contrast text, or install the matching Windows OCR language pack."
                               Style="{StaticResource HelpText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource FooterBar}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource AppMutedForeground}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <Button x:Name="CopyButton"
                            Content="Copy text"
                            Style="{StaticResource AccentButton}"
                            Click="OnCopyClicked"
                            Padding="14,6" />
                    <Button x:Name="CloseButton" Content="Close" Click="OnCloseClicked" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
