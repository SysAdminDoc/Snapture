<Window x:Class="Snapture.App.Views.StepCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture — Step Capture"
        Width="980" Height="680"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Step Capture"
                               Style="{StaticResource WindowTitleText}"
                               Foreground="{DynamicResource AppAccent}" />
                    <TextBlock Text="Record a workflow, caption each step, then export Markdown, Word, or PowerPoint."
                               Style="{StaticResource HelpText}"
                               Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="StartStopButton"
                                Content="Start recording"
                                Style="{StaticResource AccentButton}"
                                Click="OnStartStopClicked" />
                        <TextBlock x:Name="StatusText"
                                   Foreground="{DynamicResource AppMutedForeground}"
                                   VerticalAlignment="Center"
                                   Margin="14,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="18,0,0,0">
                    <TextBox x:Name="TitleBox"
                             Width="220"
                             ToolTip="Document title used in the exported documents"
                             Text="My step-by-step guide" />
                    <Button x:Name="ExportButton"
                            Content="Export Markdown"
                            Click="OnExportClicked" />
                    <Button x:Name="ExportDocxButton"
                            Content="Export DOCX"
                            Click="OnExportDocxClicked"
                            ToolTip="Export an editable Word document with each step image and caption." />
                    <Button x:Name="ExportPptxButton"
                            Content="Export PPTX"
                            Click="OnExportPptxClicked"
                            ToolTip="Export a title slide and editable step slides for PowerPoint." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource AppCanvas}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="StepsList" Margin="14" />
            </ScrollViewer>
            <Border x:Name="EmptyState"
                    Style="{StaticResource SectionPanel}"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="EmptyTitleText"
                               Text="Ready to record a walkthrough"
                               Style="{StaticResource SectionTitleText}"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock x:Name="EmptyBodyText"
                               Text="Click Start recording, complete the workflow, then stop to review captured steps and add captions."
                               Style="{StaticResource HelpText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource FooterBar}"
                Padding="14,8">
            <TextBlock x:Name="FooterText"
                       Foreground="{DynamicResource AppMutedForeground}"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
