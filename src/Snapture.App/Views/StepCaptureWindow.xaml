<Window x:Class="Snapture.App.Views.StepCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture — Step Capture"
        Width="980" Height="680"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Base}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Mantle}"
                BorderBrush="{DynamicResource Surface0}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="True">
                <TextBlock Text="✦ Step Capture"
                           Foreground="{DynamicResource Mauve}"
                           FontWeight="SemiBold"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"
                           DockPanel.Dock="Left" />
                <Button x:Name="StartStopButton"
                        DockPanel.Dock="Left"
                        Content="Start recording"
                        Style="{StaticResource AccentButton}"
                        Click="OnStartStopClicked" />
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource Subtext}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <TextBox x:Name="TitleBox"
                             Width="240"
                             Padding="6,4"
                             ToolTip="Document title used in the exported Markdown"
                             Text="My step-by-step guide" />
                    <Button x:Name="ExportButton"
                            Content="Export Markdown"
                            Click="OnExportClicked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="StepsList" Margin="14" />
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource Mantle}"
                BorderBrush="{DynamicResource Surface0}"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <TextBlock x:Name="FooterText"
                       Foreground="{DynamicResource Subtext}"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
