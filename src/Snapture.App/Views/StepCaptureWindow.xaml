<Window x:Class="Snapture.App.Views.StepCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture — Step Capture"
        Width="980" Height="680"
        MinWidth="700" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource HeaderBar}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Margin="0,0,18,0">
                    <TextBlock Text="Step Capture"
                               Style="{StaticResource WindowTitleText}"
                               Foreground="{DynamicResource AppAccent}" />
                    <TextBlock Text="Record a workflow, caption each step, then export a Markdown bundle."
                               Style="{StaticResource HelpText}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="StartStopButton"
                        DockPanel.Dock="Left"
                        Content="Start recording"
                        Style="{StaticResource AccentButton}"
                        Click="OnStartStopClicked" />
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource AppMutedForeground}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"
                           DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <TextBox x:Name="TitleBox"
                             Width="260"
                             ToolTip="Document title used in the exported Markdown"
                             Text="My step-by-step guide" />
                    <Button x:Name="ExportButton"
                            Content="Export Markdown"
                            Click="OnExportClicked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource AppCanvas}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="StepsList" Margin="14" />
            </ScrollViewer>
            <Border x:Name="EmptyState"
                    Style="{StaticResource SectionPanel}"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="EmptyTitleText"
                               Text="Ready to record a walkthrough"
                               Style="{StaticResource SectionTitleText}"
                               Foreground="{DynamicResource AppForeground}" />
                    <TextBlock x:Name="EmptyBodyText"
                               Text="Click Start recording, complete the workflow, then stop to review captured steps and add captions."
                               Style="{StaticResource HelpText}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Style="{StaticResource FooterBar}"
                Padding="14,8">
            <TextBlock x:Name="FooterText"
                       Foreground="{DynamicResource AppMutedForeground}"
                       FontFamily="Cascadia Code, Consolas, monospace"
                       FontSize="12"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
