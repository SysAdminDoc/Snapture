<Window x:Class="Snapture.App.Views.PixelRulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture Ruler"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">
    <Grid x:Name="RootGrid">
        <Canvas x:Name="OverlayCanvas">
            <Rectangle x:Name="DimRect" Fill="{DynamicResource DimBackdrop}" />
            <Line x:Name="MeasureLine"
                  Stroke="{DynamicResource AppAccent}"
                  StrokeThickness="2"
                  Visibility="Collapsed" />
            <Border x:Name="ReadoutBadge"
                    Style="{StaticResource OverlayInfoBadge}"
                    Visibility="Collapsed">
                <TextBlock x:Name="ReadoutText"
                           Foreground="{DynamicResource AppForeground}"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="13" />
            </Border>
            <Border x:Name="HintBadge"
                    Style="{StaticResource OverlayHintBadge}">
                <StackPanel>
                    <TextBlock Text="Pixel ruler" Style="{StaticResource OverlayHintTitleText}" />
                    <TextBlock Text="Drag to measure distance and angle. Esc dismisses."
                               Style="{StaticResource OverlayHintBodyText}" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
