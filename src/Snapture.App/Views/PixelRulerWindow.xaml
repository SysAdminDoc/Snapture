<Window x:Class="Snapture.App.Views.PixelRulerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture Ruler"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">
    <Grid x:Name="RootGrid">
        <Canvas x:Name="OverlayCanvas">
            <Rectangle x:Name="DimRect" Fill="{DynamicResource DimBackdrop}" />
            <Line x:Name="MeasureLine"
                  Stroke="{DynamicResource Accent}"
                  StrokeThickness="2"
                  Visibility="Collapsed" />
            <Border x:Name="ReadoutBadge"
                    Background="{DynamicResource Mantle}"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,4"
                    Visibility="Collapsed">
                <TextBlock x:Name="ReadoutText"
                           Foreground="{DynamicResource Text}"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="13" />
            </Border>
            <Border x:Name="HintBadge"
                    Background="{DynamicResource Mantle}"
                    BorderBrush="{DynamicResource Surface1}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,8">
                <TextBlock Foreground="{DynamicResource Subtext}" FontSize="13">
                    <Run Foreground="{DynamicResource Mauve}" Text="Drag" />
                    <Run Text=" to measure pixels and angle " />
                    <Run Foreground="{DynamicResource Surface2}" Text="·" />
                    <Run Foreground="{DynamicResource Mauve}" Text=" Esc " />
                    <Run Text="dismiss" />
                </TextBlock>
            </Border>
        </Canvas>
    </Grid>
</Window>
