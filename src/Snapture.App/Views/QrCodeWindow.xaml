<Window x:Class="Snapture.App.Views.QrCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapture — LAN share QR"
        Width="540" Height="680"
        MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource AppForeground}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <StackPanel>
                <TextBlock Text="Scan to open the LAN share"
                           Style="{StaticResource WindowTitleText}" />
                <TextBlock Text="Use your phone camera while it is on the same Wi-Fi network. The link keeps the existing TTL and single-fetch rules."
                           Style="{StaticResource HelpText}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="20,18,20,12"
                Padding="20"
                Background="White"
                BorderBrush="{DynamicResource AppBorderStrong}"
                BorderThickness="1"
                CornerRadius="10">
            <Image x:Name="QrImage"
                   Width="360"
                   Height="360"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="None"
                   SnapsToDevicePixels="True"
                   UseLayoutRounding="True" />
        </Border>

        <TextBlock x:Name="UrlText"
                   Grid.Row="2"
                   Margin="20,0,20,12"
                   Foreground="{DynamicResource AppMutedForeground}"
                   FontFamily="Cascadia Code, Consolas, monospace"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />

        <Border Grid.Row="3" Style="{StaticResource FooterBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy URL"
                        Click="OnCopyUrlClicked"
                        Padding="14,6" />
                <Button Content="Close"
                        Click="OnCloseClicked"
                        Style="{StaticResource AccentButton}"
                        Padding="14,6" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
